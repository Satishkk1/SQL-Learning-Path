--- Create a table with city name and playes from each city by creating a pivot of the below table---

---INPUT FILE ---
create table players_location
(
name varchar(20),
city varchar(20)
);
delete from players_location;
insert into players_location
values ('Sachin','Mumbai'),('Virat','Delhi') , ('Rahul','Bangalore'),('Rohit','Mumbai'),('Mayank','Bangalore');

---SOLUTION FILE---
select
  max(case when city = 'Bangalore' then name end) as Bangalore,
  max(case when city = 'Mumbai' then name end) as Mumbai,
  min(case when city = 'Delhi' then name end) as Delhi
from
  (
    select
      *,
      row_number() over (partition by city order by name asc) as player_groups
    from
      players_location ) A
group by
  player_groups
order by
  player_groups;
