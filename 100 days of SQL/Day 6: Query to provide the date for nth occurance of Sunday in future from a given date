---Write a query to provide the date for nth occurance of Sunday in future from a given date---
--datepart--
Sunday=1
Monday=2
Friday=6
Saturday=7

--INPUT DATA--
declare @today_date date;
declare @n int;
set @today_date = '2022-01-03'; -- saturday
set @n = 3;


--SOLUTION--
select dateadd(week, @n-1, dateadd(day, 8 - datepart(weekday, @today_date), @today_date));
