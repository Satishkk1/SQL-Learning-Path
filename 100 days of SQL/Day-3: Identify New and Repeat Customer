---From a given table which shows the order date and list of customeers, create a table which shows the volume of 
  new and repeat customer each day ---

--INPUT TABLE--
create table customer_orders (
order_id integer,
customer_id integer,
order_date date,
order_amount integer
);

insert into customer_orders values(1,100,cast('2022-01-01' as date),2000),(2,200,cast('2022-01-01' as date),2500),(3,300,cast('2022-01-01' as date),2100)
,(4,100,cast('2022-01-02' as date),2000),(5,400,cast('2022-01-02' as date),2200),(6,500,cast('2022-01-02' as date),2700)
,(7,100,cast('2022-01-03' as date),3000),(8,400,cast('2022-01-03' as date),1000),(9,600,cast('2022-01-03' as date),3000);


select * from customer_orders;

--SOLUTION--

WITH first_visit AS (
    SELECT customer_id,MIN(order_date) AS first_visit_dt
    FROM customer_orders
    GROUP BY customer_id
)
,visit AS (
  SELECT co.*,fv.first_visit_dt,
  CASE WHEN co.order_date = fv.first_visit_dt THEN 1 ELSE 0 END AS New_customer,
  CASE WHEN co.order_date != fv.first_visit_dt THEN 1 ELSE 0 END AS existing_customer
  FROM customer_orders co
INNER JOIN first_visit fv ON  co.customer_id = fv.customer_id
)
SELECT order_date,sum(New_customer) AS new_c,sum(existing_customer) AS repeat_customer
FROM visit
GROUP BY order_date;
