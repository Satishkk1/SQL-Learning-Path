----Write a recursive CTE which will calcualte the total sales by year from a table with start and end date

---INPUT DATA ---
create table sales ( product_id int, period_start date, period_end date, average_daily_sales int ); 
insert into sales values(1,'2019-01-25','2019-02-28',100),(2,'2018-12-01','2020-01-01',10),(3,'2019-12-01','2020-01-31',1);
select * from sales;

---OUTPUT DATA---
-- total sales by year
with recursive sk_cte as (
    select min(period_start) as dates, max(period_end) as max_date from sales
    union all
    select dates + INTERVAL 1 DAY as dates, max_date from sk_cte
    where dates < max_date
)

select product_id, year(dates) as report_year, sum(average_daily_sales) as total_amount from sk_cte
inner join sales on dates between period_start and period_end
group by product_id, year(dates)
order by product_id, year(dates);
